# GPU PC의 .env 예시. 실제 값은 이 파일을 복사해 .env에 넣는다 (.env는 커밋하지 않는다)
GPU_WORKER_API_URL=https://4cut.java21.net
GPU_WORKER_TOKEN=
WORKER_ID=gpu-pc-1
# fake: 고정 결과(연결 확인용), real: Whisper·Ollama·SDXL
WORKER_BACKEND=real
OLLAMA_URL=http://localhost:11434
WHISPER_MODEL=large-v3
SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# 768px은 16GB에 다 올라가 CPU offload를 끈다 (1024px로 되돌리면 true)
SDXL_CPU_OFFLOAD=false
# 모델을 내릴 때 시스템 RAM에 옮겨 두고 다음 작업에서 GPU로 옮기기만 한다 (SDXL, 정렬 모델)
MODEL_KEEP_IN_RAM=true
# pyannote 화자 분리용. 없으면 화자 구분 없이 전사한다
HF_TOKEN=
